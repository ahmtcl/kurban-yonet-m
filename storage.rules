rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ===== KURBAN VİDEOLARI =====
    // Kurban kesim videoları - herkes yükleyebilir ve izleyebilir
    match /kurban-videos/{videoFile} {
      allow read: if true; // Herkese açık okuma
      allow write: if true; // Herkes yükleyebilir (GEÇİCİ - production'da düzelt)
      allow delete: if true;
    }
    
    // ===== DİĞER DOSYALAR =====
    match /{allPaths=**} {
      allow read: if true;
      allow write: if true; // GEÇİCİ - production'da düzelt
    }
  }
}
