rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ===== KURBAN VİDEOLARI =====
    // Kurban kesim videoları - herkes izleyebilir (SMS ile gelen linkler için)
    match /kurban-videos/{videoFile} {
      allow read: if true; // Herkese açık okuma
      allow write: if request.auth != null || request.resource.size < 100 * 1024 * 1024; // 100MB limit
      allow delete: if request.auth != null;
    }
    
    // ===== DİĞER DOSYALAR =====
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
